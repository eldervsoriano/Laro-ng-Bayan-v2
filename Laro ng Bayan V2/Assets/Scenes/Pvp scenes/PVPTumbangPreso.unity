  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Tumbang Preso is a two-player game where players take turns swiping a
    slipper (tsinelas) to knock down a can. When the can is hit, the defender must
    block using keyboard controls\u2014Player 1 uses W, A, S, D, and Player 2 uses
    the arrow keys. If the block is successful, the attacker gets no points; if it
    fails, the attacker scores 1 point. The game tests your aim, reflexes, and skills
    in both attacking and defending!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 86eadb08531c80f439587bcf863d682e, type: 2}
