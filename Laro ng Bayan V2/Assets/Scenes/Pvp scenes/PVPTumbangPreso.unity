  m_Script: {fileID: 11500000, guid: 01138e56e4c1b624c8cb076bc6445950, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialPanel: {fileID: 344462930}
  tutorialText: {fileID: 71164616}
  nextButton: {fileID: 408129425}
  backButton: {fileID: 122536891}
  doneButton: {fileID: 1900961173}
  skipButton: {fileID: 1081764573}
  tutorialPages:
  - text: 'Welcome to Tumbang Preso!


      Player 1 is the Brown Slipper

      Player
      2 is the Colorful Slipper'
    imageOrVideoPanel: {fileID: 1437645377}
  - text: 'To throw your slipper to the can. Hold Left Click and pull back your mouse
      to aim, then let it go


      The slipper will throw where you flick it. '
    imageOrVideoPanel: {fileID: 1990902579}
  - text: "After a player's slipper hit the can. A prompt will appear for the other
      player. \n\nIn the prompt, this player must press Space when the yellow bar
      is inside the red bar zone. If the player hits the red box, it would block
      and "
    imageOrVideoPanel: {fileID: 1930040953}
  - text: "If the player hits the red box, it would block the can and that player
      who throw the can wouldn't get a score. \n\nBut, if the player miss the red
      box, that player who threw the can will get a score.\n\nThe overall score to
      win is 5."
    imageOrVideoPanel: {fileID: 1876694718}
  shooters: []
  startAfterCutscene: 0
