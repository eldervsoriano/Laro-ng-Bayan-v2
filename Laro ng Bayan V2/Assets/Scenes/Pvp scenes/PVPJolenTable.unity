  skipButton: {fileID: 1268388791}
  tutorialPages:
  - text: "Welcome to Jolen! \r\n\r\nPlayer 1 is Blue and Player 2 is Red.\r\n"
    imageOrVideoPanel: {fileID: 1837886004}
  - text: "Press and hold Left-Click Mouse Button. Then drag it away from your Jolen
      to draw power. \r\n\r\nYou can also Aim your Jolen's diirection by moving your
      mouse around the Jolen."
    imageOrVideoPanel: {fileID: 1981241578}
  - text: 'To shoot your Jolen, let go of the Left-mouse Button.

'
    imageOrVideoPanel: {fileID: 1402586703}
  - text: "In order to score. You must let the Yellow-White Jolens away from their
      Square. \r\n\r\nIf you manage to make a Jolen roll away from the square, you
      will score a 1 point. \r\n\r\nTo Win you must score 5 points."
    imageOrVideoPanel: {fileID: 129890062}
  shooters: []
  startAfterCutscene: 0
